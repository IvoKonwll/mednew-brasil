# Supabase — copie para .env.local e preencha com as chaves do seu projeto.
# Painel: https://app.supabase.com -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# NUNCA exponha esta chave no frontend. Use apenas em código server-side / cron.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# URL pública do site (usada em SEO / sitemap / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo opcional para proteger a rota de cron (?secret=...)
CRON_SECRET=troque-este-valor
